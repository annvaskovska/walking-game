{
  "name": "mr-sparkles",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mr Sparkles: your city's coloring book. Every street you walk gets colored in with crayon, for good.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "ios:sync": "npm run build && cap sync ios",
    "ios": "npm run ios:sync && cap open ios",
    "ios:testflight": "sh scripts/testflight.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "earcut": "^3.2.4",
    "maplibre-gl": "^6.18.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/geojson": "^7946.0.16",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
